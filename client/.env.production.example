# Client configuration — copy to .env.production and fill in real values.
#
# Same-origin deployment (vedoras.com + Nginx reverse proxy): keep these
# relative so the browser talks to the same origin and the proxy forwards
# /api and /socket.io to the Node backend. No CORS, cookies just work.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=/
#
# Alternative: API on a subdomain (api.vedoras.com) would need:
#   VITE_API_URL=https://api.vedoras.com/api/v1
#   VITE_SOCKET_URL=https://api.vedoras.com
# plus CORS allow-list and COOKIE_SAME_SITE=none on the server.
