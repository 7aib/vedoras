# Server configuration — copy to .env and fill in real values.

# --- Application ---
NODE_ENV=development
PORT=5000
API_VERSION=v1
# Comma-separated origin allow-list for CORS
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Local (docker-compose):
MONGODB_URI=mongodb://vedoras:vedoras@localhost:27017/vedoras?authSource=admin
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vedoras?retryWrites=true&w=majority

# Trust the first proxy hop (set true when behind nginx/reverse proxy).
TRUST_PROXY=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter per-IP limit on register/login.
AUTH_RATE_LIMIT_MAX=20

# --- Authentication (JWT) ---
# Generate strong secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=vedoras

# Refresh token cookie: lax | strict | none
COOKIE_SAME_SITE=lax

# --- Media / uploads ---
# Local upload directory (relative to the server cwd). Ignored by git.
UPLOAD_DIR=uploads
# Max files per upload request and max size per file (MB).
UPLOAD_MAX_FILES=10
UPLOAD_MAX_SIZE_MB=5

# --- Cloudinary (optional) ---
# When all three are set, images upload to Cloudinary instead of local disk.
# When unset (development/tests), uploads fall back to /uploads static storage.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_UPLOAD_FOLDER=vedoras

# ---------------------------------------------------------------------------
# Production — vedoras.com on a Hostinger VPS (Nginx, same origin)
# Copy `server/.env.production` from the repo to the VPS and adjust secrets.
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=5000
# API_VERSION=v1
# # Nginx serves the SPA from vedoras.com and proxies /api + /socket.io here.
# CLIENT_URL=https://vedoras.com,https://www.vedoras.com
#
# # MongoDB installed on the VPS, bound to 127.0.0.1.
# MONGODB_URI=mongodb://127.0.0.1:27017/vedoras
#
# # Behind a reverse proxy so rate limits and logs see the real client IP.
# TRUST_PROXY=true
#
# # Generate strong secrets and change them on the VPS:
# # openssl rand -base64 48
# JWT_ACCESS_SECRET=replace_with_a_generated_secret
# JWT_REFRESH_SECRET=replace_with_a_generated_secret
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d
# JWT_ISSUER=vedoras
# COOKIE_SAME_SITE=lax
#
# # Absolute path so the process working directory never matters (pm2/systemd).
# UPLOAD_DIR=/var/www/vedoras/uploads
#
# Nginx requirements (all on https://vedoras.com and https://www.vedoras.com, same
# origin — apply deploy/nginx-vedoras.conf on the VPS; it includes the www vhost,
# the /api, /uploads and /socket.io proxies and the SPA fallback):
#   location /api       { proxy_pass http://127.0.0.1:5000; proxy_set_header X-Forwarded-Proto $scheme; ... }
#   location /uploads   { proxy_pass http://127.0.0.1:5000; }
#   location /socket.io { proxy_pass http://127.0.0.1:5000; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; }
#   location /          { try_files $uri /index.html; }   # SPA fallback for the Vite build
