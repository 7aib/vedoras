# Server configuration — copy to .env and fill in real values.

# --- Application ---
NODE_ENV=development
PORT=5000
API_VERSION=v1
# Comma-separated origin allow-list for CORS
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Local (docker-compose):
MONGODB_URI=mongodb://vedoras:vedoras@localhost:27017/vedoras?authSource=admin
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vedoras?retryWrites=true&w=majority

# Trust the first proxy hop (set true when behind nginx/reverse proxy).
TRUST_PROXY=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter per-IP limit on register/login.
AUTH_RATE_LIMIT_MAX=20

# --- Authentication (JWT) ---
# Generate strong secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=vedoras

# Refresh token cookie: lax | strict | none
COOKIE_SAME_SITE=lax

# --- Media / uploads ---
# Local upload directory (relative to the server cwd). Ignored by git.
UPLOAD_DIR=uploads
# Max files per upload request and max size per file (MB).
UPLOAD_MAX_FILES=10
UPLOAD_MAX_SIZE_MB=5

# --- Cloudinary (optional) ---
# When all three are set, images upload to Cloudinary instead of local disk.
# When unset (development/tests), uploads fall back to /uploads static storage.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_UPLOAD_FOLDER=vedoras

# ---------------------------------------------------------------------------
# Production — vedoras.com on Hostinger SHARED hosting (hPanel Node.js app)
# Set these in hPanel -> Websites -> vedoras.com -> Node.js -> Environment
# variables. Do NOT set PORT: Hostinger assigns a runtime port and the app
# binds process.env.PORT. Full walkthrough: deploy/hostinger-shared-hosting.md
# ---------------------------------------------------------------------------
# NODE_ENV=production
# API_VERSION=v1
# # Same-origin: the Node process serves the built SPA (CLIENT_DIST) and the
# # API under /api, so CORS is not needed.
# CLIENT_URL=https://vedoras.com,https://www.vedoras.com
#
# # External DB required (shared hosting has no MongoDB) — Atlas free cluster:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vedoras?retryWrites=true&w=majority
#
# # Behind Hostinger's front proxy so rate limits/logs see the real client IP.
# TRUST_PROXY=true
#
# # Generate strong secrets: openssl rand -base64 48
# JWT_ACCESS_SECRET=replace_with_a_generated_secret
# JWT_REFRESH_SECRET=replace_with_a_generated_secret
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d
# JWT_ISSUER=vedoras
# COOKIE_SAME_SITE=lax
#
# # Absolute uploads dir OUTSIDE public_html so git redeploys never wipe files.
# UPLOAD_DIR=/home/u430927796/domains/vedoras.com/uploads
#
# # The Node process serves every request itself (no nginx). Point at the web
# # root that the git-deploy install command fills with `cp -r client/dist/. .`
# # so the API and the built SPA share one origin.
# CLIENT_DIST=/home/u430927796/domains/vedoras.com/public_html
#
# Optional: if you later move to a real VPS with Nginx, apply
# deploy/nginx-vedoras.conf and unset CLIENT_DIST so nginx serves the SPA.
